#include <stdio.h>

#define MAX 7

int box[MAX];
int top = -1;

// Push
void push(int value) {
    if (top == MAX - 1) {
        printf("Stack is full\n");
    } else {
        top++;
        box[top] = value;
        printf("%d pushed into the stack\n", value);
    }
}

// Traverse / Display
void display() {
    if (top == -1) {
        printf("Stack is empty\n");
    } else {
        printf("Stack elements are:\n");

        for (int i = top; i >= 0; i--) {
            printf("%d\n", box[i]);
        }
    }
}

// Pop
void pop() {
    if (top == -1) {
        printf("Stack is empty\n");
    } else {
        printf("%d popped from the stack\n", box[top]);
        top--;
    }
}

int main() {
    push(10);
    push(20);
    push(30);
    push(40);

    display();

    pop();

    display();

    return 0;
}
